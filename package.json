{
  "name": "qrick",
  "version": "1.1.0",
  "private": true,
  "license": "0BSD",
  "description": "Generate and scan QR codes. Everything stays on your device.",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26.8.2"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run icons && npm run build:extension && npm run build:bookmarklet",
    "build:extension": "node scripts/build-extension.mjs",
    "build:bookmarklet": "node scripts/build-bookmarklet.mjs",
    "assets:store": "node scripts/capture-store-assets.mjs",
    "validate:assets": "node scripts/validate-store-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package-release.mjs",
    "release:check": "node scripts/version.mjs --check && npm run verify && npm run package && npm run lint:firefox",
    "version:set": "node scripts/version.mjs --set",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-bookmarklet.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke && npm run validate:extension && npm run validate:assets",
    "validate:extension": "node scripts/validate-extension.mjs",
    "lint:firefox": "npx --yes web-ext@10.6.0 lint --source-dir dist/extension-firefox --warnings-as-errors",
    "assets:promo": "npx --yes --package=sharp-cli@5.2.0 sharp --input store-assets/source/promo-generate-scan-generated.png --output store-assets/chrome/promo-small-440x280.png --format png resize 440 280 --fit cover"
  },
  "dependencies": {
    "qr": "^0.7.2",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
